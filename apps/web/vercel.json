{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && sh scripts/vercel-build.sh",
  "functions": {
    "src/pages/api/v1/[...path].ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/v1/internal/cron/daily", "schedule": "0 4 * * *" }]
}
